# -*- coding: utf-8 -*-
import os
import json
import requests
import time
from datetime import datetime

# --- Konfigurasi Warna ANSI ---
RED    = "\033[1;91m"
WHITE  = "\033[1;97m"
BLUE   = "\033[1;94m"
CYAN   = "\033[1;96m"
GREEN  = "\033[1;92m"
YELLOW = "\033[1;93m"
RESET  = "\033[0m"

# --- Konfigurasi File & Folder ---
FOLDER_HASIL = "hasil"
FILE_LIMIT = ".log_spam.json"
LIMIT_HARIAN = 5

# Memastikan folder 'hasil' sudah ada
if not os.path.exists(FOLDER_HASIL):
    os.makedirs(FOLDER_HASIL)

def muat_log_limit():
    """Fungsi pembantu untuk memuat data limit saat ini"""
    hari_ini = datetime.now().strftime("%Y-%m-%d")
    if os.path.exists(FILE_LIMIT):
        try:
            with open(FILE_LIMIT, 'r') as f:
                log_data = json.load(f)
        except json.JSONDecodeError:
            log_data = {}
    else:
        log_data = {}

    if log_data.get("tanggal") != hari_ini:
        log_data = {"tanggal": hari_ini, "jumlah_request": 0}
    
    return log_data

def cek_limit():
    """Hanya memeriksa apakah limit sudah terpenuhi atau belum"""
    log_data = muat_log_limit()
    if log_data["jumlah_request"] >= LIMIT_HARIAN:
        time.sleep(1)
        print(f"\n {RED}[{WHITE}!{RED}] {YELLOW}Batas penggunaan harian tercapai. Silakan coba lagi besok!{RESET}")
        return False
    return True

def tambah_hitungan_limit():
    """Menambahkan hitungan limit jika data valid ditemukan"""
    log_data = muat_log_limit()
    log_data["jumlah_request"] += 1
    with open(FILE_LIMIT, 'w') as f:
        json.dump(log_data, f, indent=4)
    print(f" {RED}[{WHITE}+{RED}] {BLUE}Penggunaan hari ini: {GREEN}{log_data['jumlah_request']}{BLUE}/{RED}{LIMIT_HARIAN}{RESET}")

# --- Alur Utama Program ---
nomor_hp = input(f" {RED}[{WHITE}+{RED}] {BLUE}Masukkan nomor telepon {RED}( 628xxx ) {CYAN}: {RESET}").strip()

if nomor_hp:
    # 1. Cek apakah hari ini sudah limit sebelum menembak API
    if cek_limit():
        data = {
            "token": "8658375905:mJTNnCE4",
            "request": nomor_hp,
            "limit": 100,
            "lang": "id"
        }

        url = 'https://leakosintapi.com/'

        try:
            print(f" {RED}[{WHITE}*{RED}] {BLUE}Memproses permintaan...{RESET}")
            response = requests.post(url, json=data, timeout=15)
            
            # Ambil response asli dalam bentuk string/json untuk dicek syaratnya
            response_json = response.json()
            json_string_asli = json.dumps(response_json, ensure_ascii=False)
            
            # Format string untuk tampilan terminal dan file (menghapus " dan ,)
            json_string_tampilan = json.dumps(response_json, indent=3, ensure_ascii=False)
            karakter_dihapus = ['"', ',']
            for char in karakter_dihapus:
                json_string_tampilan = json_string_tampilan.replace(char, '')
                
            # Cetak hasilnya di terminal
            print(json_string_tampilan)

            # 2. Logika Pengecekan Limit Baru:
            # Mengubah semua ke lowercase agar pengecekan tidak sensitif huruf kapital (case-insensitive)
            cek_string = json_string_asli.lower()
            
            if "no results found" in cek_string or "error" in cek_string:
                print(f" {RED}[{WHITE}!{RED}] {YELLOW}Hasil kosong. Limit tidak dikurangi.{RESET}")
            else:
                # Jika hasil valid (tidak mengandung kata di atas), tambah hitungan limit harian
                tambah_hitungan_limit()

            # 3. Simpan ke dalam file di folder 'hasil'
            waktu_sekarang = datetime.now().strftime("%Y.%m.%d_%H.%M")
            nama_file = f"{nomor_hp}_{waktu_sekarang}.txt"
            path_file = os.path.join(FOLDER_HASIL, nama_file)

            with open(path_file, 'w', encoding='utf-8') as f:
                f.write(json_string_tampilan)
                
            print(f" {RED}[{WHITE}+{RED}] {BLUE}Hasil disimpan di {CYAN}: {RESET}{path_file}{RESET}")

        except Exception as e:
            print(f" {RED}[{WHITE}!{RED}] {YELLOW}Terjadi kesalahan saat menghubungi API: {RED}{e}{RESET}")
else:
    print(f" {RED}[{WHITE}!{RED}] {YELLOW}Error: Input nomor HP tidak boleh kosong!{RESET}")
