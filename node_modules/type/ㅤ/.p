PACKS = {"email": EMAIL_PACK, "domain": DOMAIN_PACK, "footprint": FOOTPRINT_PACK}

PACK_META = {
    "email":     {"name": "Email",   "hint": "An email address you control"},
    "domain":    {"name": "Domain",    "hint": "A domain you own or are authorized to test"},
    "footprint": {"name": "Username", "hint": "A username/handle that is yours"},
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def now_iso():
    return datetime.now(timezone.utc).isoformat()


def audit(event, **fields):
    record = {"ts": now_iso(), "event": event}
    record.update(fields)
    try:
        with open(AUDIT_PATH, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError:
        pass  # never let logging break a scan
    return record


def validate_target(scope, value):
    """Light sanity checks. Returns (ok, normalized, domain, error)."""
    value = (value or "").strip()
    if not value:
        return False, "", "", "Target is empty."
    if len(value) > 254:
        return False, "", "", "Target is too long."

    if scope == "email":
        if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", value):
            return False, "", "", "That doesn't look like an email address."
        domain = value.split("@", 1)[1].lower()
        return True, value, domain, ""

    if scope == "domain":
        v = re.sub(r"^https?://", "", value, flags=re.I).strip("/").lower()
        v = v.split("/", 1)[0]
        if not re.fullmatch(r"[a-z0-9.-]+\.[a-z]{2,}", v):
            return False, "", "", "That doesn't look like a domain (example: yoursite.com)."
        return True, v, v, ""

    if scope == "footprint":
        if not re.fullmatch(r"[A-Za-z0-9._\-]{2,64}", value):
            return False, "", "", "Use a plain handle: letters, numbers, dot, dash, underscore."
        return True, value, "", ""

    return False, "", "", f"Unknown scope '{scope}'."


def build_queries(scope, value, domain, enabled_ids=None):
    out = []
    for item in PACKS[scope]:
        if enabled_ids is not None and item["id"] not in enabled_ids:
            continue
        q = item["q"].replace("{VALUE}", value).replace("{DOMAIN}", domain or value)
        out.append({"id": item["id"], "label": item["label"], "why": item["why"], "query": q})
    return out


def serper_search(query, api_key, timeout=20):
    """Run one query through Serper.dev. Returns (results, error)."""
    if not api_key:
        return [], "no_serper_key"
    body = json.dumps({"q": query, "num": 10}).encode("utf-8")
    req = urllib.request.Request(
        "https://google.serper.dev/search",
        data=body,
        headers={"X-API-KEY": api_key, "Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        return [], f"http_{e.code}"
    except Exception as e:  # noqa: BLE001
        return [], f"error:{type(e).__name__}"

    results = []
    for r in data.get("organic", [])[:10]:
        results.append({
            "title": r.get("title", ""),
            "link": r.get("link", ""),
            "snippet": r.get("snippet", ""),
        })
    return results, None


def llm_summarize(scope, target, findings, cfg, timeout=40):
    """Ask the configured LLM to turn raw hits into a remediation-focused brief."""
    api_key = cfg.get("api_key")
    if not api_key:
        return None, "no_llm_key"

    provider = (cfg.get("provider") or "openai").lower()
    model = cfg.get("model") or ("claude-3-5-sonnet-20241022" if provider == "anthropic" else "gpt-4o-mini")

    compact = []
    for f in findings:
        compact.append({
            "check": f["label"],
            "hits": [{"title": h["title"], "link": h["link"]} for h in f["results"][:5]],
        })

    system = (
        "You are a defensive security assistant. The user is assessing the exposure of an asset "
        "THEY OWN. Summarize what the search hits reveal about their own exposure and give concrete, "
        "prioritized remediation steps (rotate, de-index, lock down, request removal). Do not help "
        "profile or target other people. Be concise and practical. Output plain text with short sections."
    )
    user = (
        f"Scope: {scope}\nTarget (owned by the user): {target}\n\n"
        f"Search findings (JSON):\n{json.dumps(compact, ensure_ascii=False)}\n\n"
        "Give: (1) a one-line risk read, (2) the top issues found, (3) a prioritized fix list."
    )

    try:
        if provider == "anthropic":
            base = cfg.get("base_url") or "https://api.anthropic.com/v1"
            body = json.dumps({
                "model": model, "max_tokens": 900, "system": system,
                "messages": [{"role": "user", "content": user}],
            }).encode("utf-8")
            req = urllib.request.Request(
                base.rstrip("/") + "/messages", data=body,
                headers={"x-api-key": api_key, "anthropic-version": "2023-06-01",
                         "Content-Type": "application/json"}, method="POST")
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            parts = [b.get("text", "") for b in data.get("content", []) if b.get("type") == "text"]
            return "\n".join(p for p in parts if p), None
        else:  # openai-compatible
            base = cfg.get("base_url") or "https://api.openai.com/v1"
            body = json.dumps({
                "model": model, "max_tokens": 900,
                "messages": [{"role": "system", "content": system},
                             {"role": "user", "content": user}],
            }).encode("utf-8")
            req = urllib.request.Request(
                base.rstrip("/") + "/chat/completions", data=body,
                headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
                method="POST")
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            return data["choices"][0]["message"]["content"], None
    except urllib.error.HTTPError as e:
        return None, f"http_{e.code}"
    except Exception as e:  # noqa: BLE001
        return None, f"error:{type(e).__name__}"


# ---------------------------------------------------------------------------
# HTTP handler
# ---------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    server_version = "Kronyx/" + VERSION

    def log_message(self, *args):  # quieter console
        pass

    def _send(self, code, payload, ctype="application/json"):
        if ctype == "application/json":
            body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        else:
            body = payload if isinstance(payload, bytes) else payload.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if "json" in ctype or "html" in ctype else ""))
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self._send(204, b"", ctype="text/plain")

    def do_GET(self):
        if self.path.split("?")[0] == "/health":
            return self._send(200, {
                "status": "ok",
                "service": "kronyx",
                "version": VERSION,
                "uptime_seconds": round(time.time() - START_TIME, 1),
                "serper_configured": bool(os.environ.get("KRONYX_SERPER_KEY")),
                "llm_configured": bool(os.environ.get("KRONYX_LLM_API_KEY")),
                "scopes": list(PACKS.keys()),
                "time": now_iso(),
            })
        if self.path.split("?")[0] == "/packs":
            return self._send(200, {
                "packs": {s: [{"id": i["id"], "label": i["label"], "why": i["why"]} for i in p]
                          for s, p in PACKS.items()},
                "meta": PACK_META,
            })
        if self.path in ("/", "/index.html"):
            if os.path.exists(INDEX_PATH):
                with open(INDEX_PATH, "rb") as fh:
                    return self._send(200, fh.read(), ctype="text/html")
            return self._send(404, {"error": "index.html not found next to server.py"})
        return self._send(404, {"error": "not_found"})

    def do_POST(self):
        if self.path.split("?")[0] != "/scan":
            return self._send(404, {"error": "not_found"})
        try:
            length = int(self.headers.get("Content-Length", 0))
            req = json.loads(self.rfile.read(length).decode("utf-8")) if length else {}
        except (ValueError, json.JSONDecodeError):
            return self._send(400, {"error": "bad_json"})

        scope = req.get("scope")
        target = req.get("target", "")
        authorized = bool(req.get("authorized"))
        enabled_ids = req.get("checks")  # optional list of pack ids
        operator = (req.get("operator") or "anonymous")[:80]

        if scope not in PACKS:
            return self._send(400, {"error": "unknown_scope"})

        # Hard authorization gate — no scan runs without it.
        if not authorized:
            audit("scan_blocked", scope=scope, reason="no_authorization", operator=operator)
            return self._send(403, {
                "error": "authorization_required",
                "message": "Confirm you own or are authorized to assess this target before scanning.",
            })

        ok, value, domain, err = validate_target(scope, target)
        if not ok:
            return self._send(400, {"error": "invalid_target", "message": err})

        # Resolve API keys: request body overrides environment.
        serper_key = (req.get("serper_key") or os.environ.get("KRONYX_SERPER_KEY") or "").strip()
        llm_cfg = {
            "provider": req.get("llm_provider") or os.environ.get("KRONYX_LLM_PROVIDER") or "openai",
            "api_key": (req.get("llm_key") or os.environ.get("KRONYX_LLM_API_KEY") or "").strip(),
            "base_url": req.get("llm_base_url") or os.environ.get("KRONYX_LLM_BASE_URL") or "",
            "model": req.get("llm_model") or os.environ.get("KRONYX_LLM_MODEL") or "",
        }

        queries = build_queries(scope, value, domain, enabled_ids)
        audit("scan_start", scope=scope, target=value, queries=len(queries), operator=operator)

        findings, errors = [], []
        for qd in queries:
            results, qerr = serper_search(qd["query"], serper_key)
            if qerr:
                errors.append({"id": qd["id"], "error": qerr})
            findings.append({**qd, "results": results, "count": len(results)})

        summary, summary_err = (None, None)
        if llm_cfg["api_key"] and any(f["count"] for f in findings):
            summary, summary_err = llm_summarize(scope, value, findings, llm_cfg)

        total_hits = sum(f["count"] for f in findings)
        audit("scan_done", scope=scope, target=value, total_hits=total_hits,
              query_errors=len(errors), operator=operator)

        return self._send(200, {
            "scope": scope,
            "scope_name": PACK_META[scope]["name"],
            "target": value,
            "ran_at": now_iso(),
            "query_count": len(queries),
            "total_hits": total_hits,
            "findings": findings,
            "errors": errors,
            "summary": summary,
            "summary_error": summary_err,
            "notes": ("Set a Serper key to retrieve live results."
                      if not serper_key else None),
        })


def main():
    port = int(os.environ.get("KRONYX_PORT", "8787"))
    audit("server_start", version=VERSION, port=port)
    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"\n Server berjalan di: http://127.0.0.1:{port}")
    #print(f"\n  Health   : http://127.0.0.1:{port}/health")
    #print(f"  UI:      http://127.0.0.1:{port}/  (or open index.html directly)")
    print(f" Audit log: {AUDIT_PATH}")
    print(" Buka di browser & ambil API key di https://serper.dev/\n lalu paste di pojok kanan atas.")
    print(" Peringatan: Hanya utk aset yg Anda miliki atau punya izin utk melakukan pengujian.")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n Shutting down...")
        time.sleep(1)
        httpd.shutdown()


if __name__ == "__main__":
    main()
