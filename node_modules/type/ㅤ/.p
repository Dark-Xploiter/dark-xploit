#!/usr/bin/env python3
"""
Kronyx — defensive exposure & attack-surface assessment server.

Scope: Kronyx only assesses assets you OWN or are AUTHORIZED to test
(your own email, your own domain, your own handle). It does not profile
or de-anonymize other people. Every scan requires an explicit authorization
acknowledgement and is written to an append-only audit log.

Runs on the Python standard library only — no pip install required.

    python3 server.py
    # then open index.html in a browser (or http://localhost:8787/)

Configuration (all optional, can also be sent from the UI):
    KRONYX_PORT             default 8787
    KRONYX_SERPER_KEY       Serper.dev API key (Google search)
    KRONYX_LLM_PROVIDER     "openai" (default) | "anthropic"
    KRONYX_LLM_API_KEY      key for the chosen LLM
    KRONYX_LLM_BASE_URL     default https://api.openai.com/v1
    KRONYX_LLM_MODEL        default gpt-4o-mini
"""

import json
import os
import re
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))
AUDIT_PATH = os.path.join("audit.log")
INDEX_PATH = os.path.join("index.html")
START_TIME = time.time()
VERSION = "1.0.0"

# ---------------------------------------------------------------------------
# Query packs — all oriented at reducing exposure of assets YOU control.
# {VALUE} = the user-supplied target. {DOMAIN} = auto-extracted from an email.
# Each query is a normal Google search string (run through Serper).
# ---------------------------------------------------------------------------

EMAIL_PACK = [
