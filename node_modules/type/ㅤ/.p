DOMAIN_PACK = [
    # Attack surface of a domain you own — find it before someone else does.
    {"id": "DOM-AUTH", "label": "Exposed auth surfaces",
     "q": 'site:{VALUE} (inurl:login OR inurl:admin OR inurl:portal OR inurl:webmail OR inurl:dashboard)',
     "why": "Login/admin endpoints that are publicly indexed. Make sure each one needs auth and isn't a forgotten panel."},
