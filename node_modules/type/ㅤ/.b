# -*- coding: utf-8 -*-
import zipfile
import os
import time
import zlib  # Impor pustaka zlib untuk menangkap error dekompresi

def brute():
    filezip = input(" \033[1;91m[\033[1;97m+\033[1;91m] \033[1;94mEnter Zip File \033[1;91m( ex. /sdcard/file.zip ) \033[1;96m: \033[0;97m")
    pilihan = input(" \033[1;91m[\033[1;97m+\033[1;91m] \033[1;94mWordlist Type \033[1;91m( angka / huruf ) \033[1;96m: \033[0;97m").strip().lower()
    
    print(" \033[1;34mUnlock zip file...")
    time.sleep(1)
    
    try:
        x = zipfile.ZipFile(filezip)
    except FileNotFoundError:
        print(f" \033[1;91m[!] File {filezip} tidak ditemukan.")
        return

    # Logika penentuan password berdasarkan input
    if pilihan == "huruf":
        try:
            with open("huruf.txt", "r", encoding="utf-8", errors="ignore") as p:
                passwords = [line.strip() for line in p.readlines()]
        except FileNotFoundError:
            print(" \033[1;91m[!] File huruf.txt tidak ditemukan di direktori ini.")
            return
            
    elif pilihan == "angka":
        passwords = []
        for length in range(1, 7):
            for i in range(10**length):
                passwords.append(f"{i:0{length}d}")
    else:
        print(" \033[1;91m[!] Pilihan tidak valid. Gunakan 'angka' atau 'huruf'.")
        return

    # Proses pencocokan password
    for password in passwords:
        try:
            # Python 3 memerlukan argumen pwd dalam bentuk bytes
            x.extractall(pwd=password.encode('utf-8'))
            print("\033[1;91m+\033[1;96m======================\033[1;91m+\033[1;96m=====================\033[1;91m+")
            print(" \033[1;94m(\033[1;92m•\033[1;94m) \033[1;92mPassword Found")
            print(" \033[1;94m(\033[1;92m•\033[1;94m) \033[1;92mPassword \033[1;90m~\033[1;96m•\033[1;93m>\033[1;95m", password)
            break
        # Menambahkan zlib.error dan Exception umum agar program tidak berhenti saat struktur data rusak akibat salah sandi
        except (RuntimeError, zipfile.BadZipFile, zlib.error, Exception):
            print(" \033[1;94m(\033[1;91m•\033[1;94m) \033[1;91mFailed \033[1;90m~\033[1;96m•\033[1;93m>\033[1;96m", password)

if __name__ == "__main__":
    brute()
